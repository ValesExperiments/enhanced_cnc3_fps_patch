+  void D3D9SwapChainEx::UpdateCursorClip() {
+#ifdef _WIN32
+    // Native D3D9 exclusive fullscreen keeps the cursor on the game's screen.
+    // DXVK's fullscreen does not, so on multi-monitor setups the cursor can
+    // leave the game and RTS edge scrolling stops working. Windows drops the
+    // clip on focus or display changes, so it is re-checked every present.
+    bool wantClip = m_parent->GetOptions()->clipCursor
+                 && m_monitor != nullptr
+                 && m_window != nullptr
+                 && GetForegroundWindow() == m_window
+                 && !IsIconic(m_window);
+
+    if (!wantClip) {
+      ReleaseCursorClip();
+      return;
+    }
+
+    RECT windowRect;
+    RECT currentClip;
+
+    if (!GetWindowRect(m_window, &windowRect))
+      return;
+
+    if (!m_cursorClipped || !GetClipCursor(&currentClip)
+     || !EqualRect(&currentClip, &windowRect)) {
+      if (ClipCursor(&windowRect))
+        m_cursorClipped = true;
+    }
+#endif
+  }
+
+
+  void D3D9SwapChainEx::ReleaseCursorClip() {
+#ifdef _WIN32
+    if (m_cursorClipped) {
+      ClipCursor(nullptr);
+      m_cursorClipped = false;
+    }
+#endif
+  }
