[fps_patch]

; Master switch. The dinput8 proxy still forwards normally when disabled.
enabled=1

; Supported values: 45, 60, 75, 90, or any whole number from 91 to 240
; (experimental, e.g. 120, 144, 160). Default: 90. The game logic always
; runs at 15 Hz; if your PC can't hold the chosen rate, the game slows down
; (as the retail game does below 30 FPS), so pick a rate it can sustain.
target_fps=90

; Write fps_patch.log next to the DLL.
logging=1

; Diagnostic: log this many frames of one moving vehicle's interpolation
; to fps_patch.log (requires logging=1). 0 = off.
debug_motion_frames=0

; Diagnostic: log this many frames of frame-pacing data (per game session)
; to fps_patch.log (requires logging=1). 0 = off.
debug_frame_times=0

; Diagnostic: log this many trail-particle draws (per game session) to
; fps_patch.log (requires logging=1). 0 = off.
debug_trail_draws=0
