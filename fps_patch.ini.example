[fps_patch]

; Master switch. The dinput8 proxy still forwards normally when disabled.
enabled=1

; Supported values: 45, 60, 75, 90, or any whole number from 91 to 240
; (experimental, e.g. 120, 144, 160). Default: 90. The game logic always
; runs at 15 Hz. With adaptive_fps=0, a PC that can't hold the chosen rate
; makes the whole game slow down (as the retail game does below 30 FPS).
target_fps=90

; Keep the game at 100% speed when the PC can't hold target_fps: the client
; rate drops to what it can sustain (down to 5 FPS; below 15 FPS a frame
; runs several game-logic steps) and rises again when there is headroom.
; 1 = on (default), 0 = off.
adaptive_fps=1

; Write fps_patch.log next to the DLL.
logging=1

; Diagnostic: log this many frames of one moving vehicle's interpolation
; to fps_patch.log (requires logging=1). 0 = off.
debug_motion_frames=0

; Diagnostic: log this many frames of frame-pacing data (per game session)
; to fps_patch.log (requires logging=1). 0 = off.
debug_frame_times=0

; Diagnostic: log this many trail-particle draws (per game session) to
; fps_patch.log (requires logging=1). 0 = off.
debug_trail_draws=0

; Diagnostic: log the game's queued UI (Flash) calls to fps_patch.log
; (requires logging=1). 1 = per call site once per second, 2 = every call
; and variable change with its frame number (from 10 s into a game), 0 = off.
debug_apt_calls=0

; Diagnostic: log this many lines comparing where newly appearing units are
; in the game logic and where they're drawn (with height), for their first
; 30 frames, starting 10 s into a game (requires logging=1). 0 = off.
debug_spawn_frames=0

; Diagnostic: comma-separated patch features to switch off, to find which one
; causes a glitch (e.g. selection_panel_name,objective_indicator_tick). Names
; are listed in docs/goals_detailed.md. Empty = everything on.
debug_disable=

; Diagnostic (multi-core research): sample where the game's main thread spends
; its time and write fps_profile.log next to the DLL every
; profiler_report_seconds. Costs about 3% of one CPU core. 1 = on, 0 = off.
profiler=0
profiler_report_seconds=60

; Multi-core project M1: find where a new particle effect goes in the
; particle manager's list instantly instead of searching the whole list
; (big battles). Same result as the game. 1 = on (default), 0 = off.
multicore_particle_index=1

; Diagnostic: also run the game's original searches and count any
; disagreement in fps_patch.log (slower). 1 = on, 0 = off.
multicore_verify=0

; Multi-core project M3a: the game's trail drawing read a value back out of
; GPU memory for every trail point (very slow); compute it instead. Same
; picture. 1 = on (default), 0 = off.
multicore_trail_fix=1
