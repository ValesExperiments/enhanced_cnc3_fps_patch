[fps_patch]

; Master switch. The dinput8 proxy still forwards normally when disabled.
enabled=1

; Supported values: 45, 60, 75, 90, or any whole number from 91 to 240
; (experimental, e.g. 120, 144, 160). Default: 90. The game logic always
; runs at 15 Hz. With adaptive_fps=0, a PC that can't hold the chosen rate
; makes the whole game slow down (as the retail game does below 30 FPS).
target_fps=90

; Keep the game at 100% speed when the PC can't hold target_fps: the client
; rate drops to what it can sustain (down to 5 FPS; below 15 FPS a frame
; runs several game-logic steps) and rises again when there is headroom.
; 1 = on (default), 0 = off.
adaptive_fps=1

; Write fps_patch.log next to the DLL.
logging=1

; Diagnostic: log this many frames of one moving vehicle's interpolation
; to fps_patch.log (requires logging=1). 0 = off.
debug_motion_frames=0

; Diagnostic: log this many frames of frame-pacing data (per game session)
; to fps_patch.log (requires logging=1). 0 = off.
debug_frame_times=0

; Diagnostic: log this many trail-particle draws (per game session) to
; fps_patch.log (requires logging=1). 0 = off.
debug_trail_draws=0

; Diagnostic (multi-core research): sample where the game's main thread spends
; its time and write fps_profile.log next to the DLL every
; profiler_report_seconds. Costs about 3% of one CPU core. 1 = on, 0 = off.
profiler=0
profiler_report_seconds=60
